# ============ Backend (server-side only — JANGAN pernah dikirim ke browser) ============
SPRING_PROFILES_ACTIVE=prod
# Koneksi runtime sebagai role pos_api (tanpa privilege tabel; RLS diterapkan per transaksi)
DATABASE_URL=jdbc:postgresql://db.<project>.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=pos_api
DATABASE_PASSWORD=
# Koneksi migration (owner schema). Kosongkan FLYWAY_ENABLED=false jika migration dijalankan terpisah.
MIGRATION_DATABASE_URL=
MIGRATION_DATABASE_USERNAME=postgres
MIGRATION_DATABASE_PASSWORD=
FLYWAY_ENABLED=true

# Supabase Auth
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://<project>.supabase.co/auth/v1
# Hanya jika project masih memakai legacy JWT secret (HS256)
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
POS_AUTH_PROVIDER=SUPABASE
POS_CORS_ALLOWED_ORIGINS=https://pos.example.com

# Payment gateway QRIS/e-wallet (Phase 5). NONE = belum ada penyedia: QRIS/e-wallet hanya bisa
# dipakai bila metode diset "boleh konfirmasi manual" (QRIS statis + approval supervisor).
# SIMULATOR hanya untuk profile local/test (aplikasi menolak start di prod).
POS_PAYMENT_GATEWAY=NONE
# Kunci HMAC callback penyedia (min. 32 karakter, acak). Wajib bila gateway bukan NONE.
POS_PAYMENT_CALLBACK_SECRET=

# Openbravo (Phase 9)
OPENBRAVO_BASE_URL=
OPENBRAVO_API_USERNAME=
OPENBRAVO_API_PASSWORD=

# ============ Frontend (build-time, publik) ============
VITE_AUTH_MODE=supabase
VITE_SUPABASE_URL=https://<project>.supabase.co
# anon key aman untuk browser; JANGAN memasukkan service role key di sini
VITE_SUPABASE_ANON_KEY=
