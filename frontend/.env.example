# Mode login: "supabase" (staging/production) atau "local" (pengembangan dengan backend profile local)
VITE_AUTH_MODE=local
# Base URL API. Kosongkan untuk memakai proxy Vite (/api -> localhost:8080) atau reverse proxy Nginx.
VITE_API_BASE_URL=
# Hanya untuk mode supabase. Anon key aman untuk browser; JANGAN pernah memasukkan service role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
